# Backend database settings.
# Keep SQLite for the Phase 1 smoke test. Set DB_ENGINE=mysql when configuring MySQL.
DB_ENGINE=sqlite
DB_NAME=meditrack
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Generate a new secret for each local environment before deploying.
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Kolkata
